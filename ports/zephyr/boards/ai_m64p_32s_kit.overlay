/ {
	chosen {
		zephyr,mbedtls-heap = &heap_mbedtls;
	};

	fstab {
		compatible = "zephyr,fstab";
		lfs: lfs {
			compatible = "zephyr,fstab,littlefs";
			mount-point = "/flash";
			partition = <&storage_partition>;
			read-size=<16>;
			prog-size=<256>;
			cache-size=<1024>;
			lookahead-size=<32>;
			block-cycles=<4>;
		};
	};

	heap_psram {
		compatible = "micropython,heap";
		size = <DT_SIZE_K(3968)>;
		memory-region = <&psram>;
	};

	heap_mbedtls: heap_mbedtls {
		compatible = "zephyr,heap";
		size = <DT_SIZE_K(128)>;
		memory-region = <&psram>;
	};
};

&wdt0 {
	status = "okay";
};

/delete-node/ &slot0_partition;
/delete-node/ &storage_partition;

&gd25lq32d {
	partitions {
		ranges;
		#address-cells = <1>;
		#size-cells = <1>;

		slot0_partition: partition@2000 {
			compatible = "zephyr,mapped-partition";
			label = "image-0";
			reg = <0x00002000 (0x00200000 - 0x2000)>;
			read-only;
		};

		storage_partition: partition@200000 {
			compatible = "zephyr,mapped-partition";
			label = "storage";
			reg = <0x00200000 0x200000>;
		};
	};
};

&pinctrl {
	uart1_default: uart1_default {
		group1 {
			pinmux = <GPIO3_UART1_TX>;
		};
	};
};

/* Fit envelope better to actual wireless RAM usage
 * BLE takes off 16KB off WRAM
 * Additionally, wifi picks about 69KB of uncached WRAM
 */

&all_ram {
	reg = <0x60fc0000 DT_SIZE_K(290)>;
	ranges = <0x0 0x60fc0000 DT_SIZE_K(290)>;
};

&wifi_ram {
	/* 0x20fc0000 + all_ram */
	reg = <0x21008800 DT_SIZE_K(69)>;
	ranges = <0x0 0x21008800 DT_SIZE_K(69)>;
};

&uart1 {
	status = "okay";
	current-speed = <115200>;
	zephyr,deferred-init;
	/* A pinctrl struct MUST have been allocated at build time to use dynamic pinctrl,
	 * but it can be nonsense if needed as the device is deferred-init
	 * and pinctrl won't be applied until device init.
	 */
	pinctrl-0 = <&uart1_default>;
	pinctrl-names = "default";
};

&pinctrl {
	uart2_default: uart2_default {
		group1 {
			pinmux = <GPIO3_UART2_TX>;
		};
	};
};

&uart2 {
	status = "okay";
	current-speed = <115200>;
	zephyr,deferred-init;
	pinctrl-0 = <&uart2_default>;
	pinctrl-names = "default";
};

&pinctrl {
	i2c1_default: i2c1_default {
		group1 {
			pinmux = <GPIO3_I2C1_SDA>;
		};
	};
};

&i2c1 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	zephyr,deferred-init;
	pinctrl-0 = <&i2c1_default>;
	pinctrl-names = "default";
};

&pinctrl {
	spi1_default: spi1_default {
		group1 {
			pinmux = <GPIO3_SPI1_MOSI>;
		};
	};
};

&spi1 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	zephyr,deferred-init;
	pinctrl-0 = <&spi1_default>;
	pinctrl-names = "default";
};
